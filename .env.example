# Copy to .env.local (never commit it). See docs/sanity/env-setup.md.

# Sanity: public (safe in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-28

# Sanity: server-only secrets (never prefix with NEXT_PUBLIC_)
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Lead email notifications (optional)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=jayleadagriestate@gmail.com

# Site
NEXT_PUBLIC_SITE_URL=https://www.jayleadagro.com
