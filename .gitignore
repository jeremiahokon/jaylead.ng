# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: every one, including .env.example (secrets come from Vercel
# and `vercel env pull`)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Source material and build notes: not used by `next build` or the live site.
# The media the site ships is already processed into public/ and src/app/.
/jaylead_ng/
/jaylead_ng-site-build-brief.md
/playbook/
/docs

# local tooling output
/.staging
/.playwright-mcp

# One-off build tools. They already ran and their output is committed
# (public/images, src/data/images.ts, src/fonts/*.woff2, public/brand); most
# need the local /jaylead_ng/ source or Python/potrace. Kept on disk only.
/scripts/add-naira.py
/scripts/build-fonts.sh
/scripts/process-assets.mts
/scripts/trace-logo.sh
/scripts/brand/
/scripts/migrate-content-model.mts
